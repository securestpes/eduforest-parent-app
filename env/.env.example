# Copy to .env.development or .env.production (see package.json scripts).
# Use 10.0.2.2 instead of localhost when testing on Android emulator.
API_URL=http://localhost:8082/api
APP_ENV=development
# Bump for each store release (must match android/app/build.gradle versionCode).
APP_VERSION=1.0.6
APP_BUILD_NUMBER=7
# Firebase phone OTP (Android). Same as gentrack-app. false = backend SMS OTP.
FIREBASE_LOGIN=false
# Expo Go only: stub native Firebase modules (does not replace FIREBASE_LOGIN).
# EXPO_PUBLIC_DISABLE_FIREBASE=true
# Expo Go testing: stub RNFB + use backend SMS OTP. Keep false for production/native builds.
EXPO_PUBLIC_DISABLE_FIREBASE=false
